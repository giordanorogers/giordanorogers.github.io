---
import '@fontsource/sora/400.css';
import '@fontsource/sora/600.css';
import '../styles/global.css';
import Constellation from '../components/Constellation.astro';

interface Props {
  title: string;
  description: string;
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Gio Rogers" href={new URL('rss.xml', Astro.site)} />
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem('theme') ?? 'dark';
    </script>
  </head>
  <body>
    <header class="site-header">
      {
        home ? (
          <div class="masthead">
            <span class="site-name">Gio Rogers</span>
            <Constellation />
          </div>
        ) : (
          <a class="mono-link" href="/">&larr; Essays</a>
        )
      }
      <nav class="header-nav">
        {home && <a class="mono-link" href="/about/">About</a>}
        <button id="theme-toggle" aria-label="Toggle color theme">
          <svg class="sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <circle cx="8" cy="8" r="3.2"></circle>
            <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M12.95 3.05l-1.4 1.4M4.45 11.55l-1.4 1.4"></path>
          </svg>
          <svg class="moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M13.5 9.5A6 6 0 1 1 6.5 2.5a4.8 4.8 0 0 0 7 7z"></path>
          </svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a class="mono-link" href="/rss.xml">RSS</a>
    </footer>
    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const el = document.documentElement;
        el.dataset.theme = el.dataset.theme === 'light' ? 'dark' : 'light';
        localStorage.setItem('theme', el.dataset.theme);
      });
    </script>
  </body>
</html>

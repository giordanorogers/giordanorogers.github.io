---
import '@fontsource/sora/latin-400.css';
import '../styles/global.css';
import Constellation from '../components/Constellation.astro';
interface Props {
  title: string;
  description: string;
  home?: boolean;
  canonicalPath?: string;
  noindex?: boolean;
  published?: Date;
  updated?: Date;
}
const { title, description, home = false, noindex = false, published, updated, canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const image = new URL('/images/gio-rogers-social.png', Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Gio Rogers" href={new URL('/rss.xml', Astro.site)} />
    <meta property="og:site_name" content="Gio Rogers" />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gio Rogers" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Gio Rogers" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch { /* The default theme still works when storage is unavailable. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="masthead">
        {home ? <h1 class="site-name">Gio Rogers</h1> : <a class="site-name" href="/">Gio Rogers</a>}
        {home && <Constellation />}
      </div>
      <nav class="header-nav" aria-label="Main navigation">
        <a class="mono-link" href="/#writing">Writing</a>
        <a class="mono-link" href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a>
        <button id="theme-toggle" type="button" aria-label="Use light theme" aria-pressed="false" hidden>
          <svg class="sun" width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <circle cx="8" cy="8" r="3.2"></circle>
            <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M12.95 3.05l-1.4 1.4M4.45 11.55l-1.4 1.4"></path>
          </svg>
          <svg class="moon" width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M13.5 9.5A6 6 0 1 1 6.5 2.5a4.8 4.8 0 0 0 7 7z"></path>
          </svg>
        </button>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <span class="footer-name">Gio Rogers</span>
      <div class="footer-links">
        <a class="mono-link" href="/about/#contact">Get in touch</a>
        <a class="mono-link" href="/rss.xml">RSS</a>
      </div>
    </footer>
    <script>
      const button = document.getElementById('theme-toggle');
      const syncButton = () => {
        const light = document.documentElement.dataset.theme === 'light';
        button?.setAttribute('aria-label', light ? 'Use dark theme' : 'Use light theme');
        button?.setAttribute('aria-pressed', String(light));
      };
      if (button) {
        syncButton();
        button.hidden = false;
        button.addEventListener('click', () => {
          const root = document.documentElement;
          root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
          syncButton();
          try { localStorage.setItem('theme', root.dataset.theme); } catch { /* Keep this page usable. */ }
        });
      }
    </script>
  </body>
</html>

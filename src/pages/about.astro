---
import Base from '../layouts/Base.astro';
---

<Base title="About — Gio Rogers" description="I work on identifying, understanding, and mitigating vulnerabilities in AI assistants and agents to make them safer.">
  <article class="prose">
    <h1 style="margin-top:52px;">About</h1>
    <p style="font-size:1.06rem; max-width:32rem;">
      I work on identifying, understanding, and mitigating vulnerabilities in AI assistants and
      agents to make them safer.
    </p>
    <p style="font-size:0.85rem; line-height:1.6; color:var(--muted); max-width:32rem; margin-bottom:44px;">
      All views on this site are my own and do not reflect those of any other organization or
      person.
    </p>
    <div class="about-links">
      <a class="mono-link" href="https://www.linkedin.com/in/giorogers">LinkedIn</a>
      <a class="mono-link" href="https://scholar.google.com/citations?user=vkcZSNAAAAAJ">Google Scholar</a>
      <a class="mono-link" href="mailto:giordanopaulrogers@gmail.com">Email</a>
    </div>
  </article>
</Base>

<style>
  .about-links {
    display: flex;
    gap: 24px;
    border-top: 1px dotted var(--border-dotted);
    padding-top: 20px;
    max-width: 32rem;
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostPreview from '../components/PostPreview.astro';
import { getPublicPosts, isPublished } from '../lib/publication.mjs';
const allPosts = await getCollection('essays');
const now = new Date();
const posts = getPublicPosts(allPosts, now);
const featured = posts.filter(post => post.data.featured);
const remaining = posts.filter(post => !post.data.featured);
const previews = import.meta.env.DEV ? allPosts.filter(post => !isPublished(post, now)) : [];
---
<Base title="Gio Rogers — AI safety, research & writing" description="Writing about AI research and safety, creativity, and art. Essays and stories by Gio Rogers." home>
  <section class="introduction" aria-label="Introduction">
    <p class="intro-lead">I’m interested in how AI works,<br class="wide-only" /> and how to make it safer.</p>
    <p>I work on identifying, understanding, and mitigating vulnerabilities in AI assistants and agents. This is where I write and think things through—from AI research and safety to creativity, art, and the rest of life.</p>
    <a class="text-link" href="/about/">A little more about me <span aria-hidden="true">↗</span></a>
  </section>
  {featured.length > 0 && (
    <section class="featured-section" aria-labelledby="start-here">
      <h2 class="section-label" id="start-here">Start here</h2>
      <ul class="essay-list featured-list">
        {featured.map(post => <li><PostPreview post={post} /></li>)}
      </ul>
    </section>
  )}
  <section class="writing-section" aria-labelledby="writing">
    <div class="section-heading">
      <h2 class="section-label" id="writing">{featured.length ? 'More writing' : 'Writing'}</h2>
      <a class="mono-link" href="/rss.xml">Follow via RSS <span aria-hidden="true">↗</span></a>
    </div>
    <ul class="essay-list">
      {remaining.map(post => <li><PostPreview post={post} /></li>)}
    </ul>
  </section>
  {previews.length > 0 && (
    <section class="preview-section" aria-labelledby="local-previews">
      <h2 class="section-label" id="local-previews">Local previews</h2>
      <p class="preview-note">Only shown by the development server. These posts are excluded from production.</p>
      <ul class="essay-list">
        {previews.map(post => (
          <li><span class="status-label">{post.data.draft ? 'Draft' : 'Scheduled'}</span><PostPreview post={post} /></li>
        ))}
      </ul>
    </section>
  )}
</Base>
